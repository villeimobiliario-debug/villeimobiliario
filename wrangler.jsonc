{
  "name": "villeimobiliario",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "main": "./src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/vitrine/*", "/vitrine", "/sitemap.xml", "/robots.txt"],
    "not_found_handling": "single-page-application"
  }
}
